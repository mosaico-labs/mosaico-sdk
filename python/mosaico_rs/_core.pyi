from typing import final

@final
class Client:
    @staticmethod
    def connect(
        host: str,
        port: int,
        timeout: float,
        tls: bool = False,
        tls_cert: bytes | None = None,
        api_key: str | None = None,
        compression: str | None = None,
        read_window_size: int | None = None,
        max_streams_per_connection: int | None = None,
    ) -> Client: ...
    def info(self) -> tuple[str, tuple[int, int, int, str | None], tuple[int, int, int]]: ...
    @property
    def max_batch_size_bytes(self) -> int: ...
    def close(self) -> None: ...
    def sequence_handler(self, name: str) -> SequenceHandler: ...
    def topic_handler(self, sequence: str, topic: str) -> TopicHandler: ...
    def sequence_create(self, name: str, metadata: str | None, on_error: str) -> SequenceWriter: ...
    def sequence_update(self, name: str, on_error: str) -> SequenceWriter: ...
    def list_sequences(self) -> list[str]: ...
    def list_sequences_page(
        self, limit: int, cursor: bytes | None, order_by: str | None
    ) -> tuple[list[str], bytes | None]: ...
    def sequence_delete(self, name: str) -> None: ...
    def session_delete(self, locator: str) -> None: ...
    def sequence_exists(self, name: str) -> bool: ...
    def topic_exists(self, sequence: str, topic: str) -> bool: ...
    def list_sequence_notifications(self, sequence: str) -> list[tuple[str, str | None, str, str, str]]: ...
    def clear_sequence_notifications(self, sequence: str) -> None: ...
    def list_topic_notifications(self, sequence: str, topic: str) -> list[tuple[str, str | None, str, str, str]]: ...
    def clear_topic_notifications(self, sequence: str, topic: str) -> None: ...

@final
class SequenceHandler:
    @property
    def name(self) -> str: ...
    @property
    def created_timestamp(self) -> int: ...
    @property
    def user_metadata(self) -> str | None: ...
    @property
    def sessions(self) -> list[tuple[str, int, int | None, list[str], bool]]: ...
    @property
    def topics(self) -> list[str]: ...
    @property
    def timestamp_ns_min(self) -> int | None: ...
    @property
    def timestamp_ns_max(self) -> int | None: ...
    def topic_handler(self, topic: str) -> TopicHandler: ...
    def get_window_streamer(
        self,
        topics: list[TopicHandler],
        start_timestamp_ns: int | None = None,
        end_timestamp_ns: int | None = None,
        join: bool = False,
    ) -> WindowStream: ...
    def reload(self) -> SequenceHandler: ...
    def close(self) -> None: ...

@final
class TopicHandler:
    @property
    def sequence_name(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def ontology_tag(self) -> str: ...
    @property
    def user_metadata(self) -> str | None: ...
    @property
    def timestamp_ns_min(self) -> int | None: ...
    @property
    def timestamp_ns_max(self) -> int | None: ...
    @property
    def msg_count(self) -> int: ...
    @property
    def created_timestamp(self) -> int: ...
    @property
    def completed_timestamp(self) -> int | None: ...
    @property
    def locked(self) -> bool: ...
    @property
    def serialization_format(self) -> str: ...
    @property
    def chunks_number(self) -> int: ...
    @property
    def total_size_bytes(self) -> int: ...
    def ontology_schema(self) -> SchemaHolder: ...
    def get_batch_streamer(
        self, start_timestamp_ns: int | None = None, end_timestamp_ns: int | None = None, join: bool = False
    ) -> BatchStream: ...
    def close(self) -> None: ...

@final
class BatchStream:
    @property
    def schema(self) -> SchemaHolder: ...
    def next_batch(self, seq: int, contended: bool = False) -> RawBatch | None: ...
    def is_closed(self) -> bool: ...
    def close(self) -> None: ...
    def export(self, seen: int) -> object: ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...

@final
class WindowStream:
    @property
    def schemas(self) -> list[SchemaHolder]: ...
    @property
    def msg_count(self) -> int: ...
    @property
    def timestamp_ns_min(self) -> int | None: ...
    @property
    def timestamp_ns_max(self) -> int | None: ...
    def next_window(
        self, seq: int, contended: bool = False
    ) -> tuple[list[tuple[int, RawBatch, list[int]]], list[int]] | None: ...
    def is_closed(self) -> bool: ...
    def close(self) -> None: ...

@final
class SchemaHolder:
    def __arrow_c_schema__(self) -> object: ...

@final
class RawBatch:
    def array_address(self) -> int: ...
    def __arrow_c_array__(self, requested_schema: object | None = None) -> tuple[object, object]: ...

@final
class SequenceWriter:
    @property
    def session_locator(self) -> str: ...
    @property
    def left_open(self) -> bool: ...
    def topic_create(
        self,
        name: str,
        ontology_tag: str,
        format: str,
        schema: object,
        metadata: str | None,
        on_error: str,
    ) -> TopicWriter: ...
    def finish(self) -> BaseException | None: ...
    def abort(self, reason: str, interrupted: bool = False) -> None: ...

@final
class TopicWriter:
    @property
    def name(self) -> str: ...
    @property
    def status(self) -> str: ...
    @property
    def last_error(self) -> str | None: ...
    @property
    def dropped_record_count(self) -> int: ...
    def push(self, kind: str, timestamp_ns: int, data: object) -> None: ...
    def push_row(self, row: object) -> None: ...
    def handle_error(self, reason: str) -> bool: ...
    def finalize(self, error: str | None = None) -> None: ...
    def push_batch(self, batch: object) -> None: ...
    def reject(self, message: str) -> BaseException: ...
    def flush(self) -> None: ...
    def set_flush_policy(
        self, max_bytes: int | None = None, max_rows: int | None = None, max_age: float | None = None
    ) -> None: ...

def topic_name(name: str) -> str: ...
def check_sequence_name(name: str) -> None: ...
def check_user_metadata(text: str) -> None: ...
def encode_png(data: object, height: int, stride: int) -> bytes: ...
def encode_png_batch(batch: object) -> RawBatch: ...
def decode_png(data: object) -> bytes: ...
def decode_png_batch(batch: object) -> RawBatch: ...
def decode_png_batches(batches: list[object]) -> list[RawBatch]: ...
